{
  "name": "browser-kit-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "A small remote Chromium engine and TypeScript SDK for Nexus agents.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @browser-kit/server dev",
    "start:server": "pnpm --filter @browser-kit/server start"
  },
  "engines": {
    "node": ">=20"
  }
}
