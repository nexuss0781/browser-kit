{
  "name": "browser-kit",
  "version": "0.1.0",
  "description": "Small TypeScript SDK and agent-tool adapter for remote Chromium sessions.",
  "license": "MIT",
  "author": "Tadiyos Aschalew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexuss0781/browser-kit.git"
  },
  "homepage": "https://github.com/nexuss0781/browser-kit#readme",
  "bugs": {
    "url": "https://github.com/nexuss0781/browser-kit/issues"
  },
  "keywords": ["browser-automation", "chromium", "playwright", "ai-agents", "nexus-agents", "remote-browser"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
